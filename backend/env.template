# MongoDB Configuration
# For local MongoDB (default):
MONGODB_URI=mongodb://localhost:27017/proget

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/proget?retryWrites=true&w=majority

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# API Version
API_VERSION=v1

# Instructions:
# 1. Copy this file to .env
# 2. Update MONGODB_URI with your MongoDB connection string
# 3. Change JWT_SECRET to a strong, random secret
# 4. Never commit .env file to git

