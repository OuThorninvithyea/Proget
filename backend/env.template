# MongoDB Configuration
# For local MongoDB (default):
MONGODB_URI=mongodb://localhost:27017/proget

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/proget?retryWrites=true&w=majority

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000

# Email Configuration (for password reset emails)
# Option 1: Use Mailtrap for testing (recommended for development)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password

# Option 2: Use Gmail (for production)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Option 3: Use SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

FROM_NAME=ProGet
FROM_EMAIL=noreply@proget.com

# API Version
API_VERSION=v1

# Instructions:
# 1. Copy this file to .env
# 2. Update MONGODB_URI with your MongoDB connection string
# 3. Change JWT_SECRET to a strong, random secret
# 4. Configure email settings (see options above)
# 5. Never commit .env file to git

